{
  "schemaVersion": 1,
  "id": "com.n1mjf.hfamp",
  "name": "RZ1ZR LDMOS Amplifier",
  "version": "0.9.0-beta.1",
  "author": "N1MJF",
  "description": "Monitoring and basic control for an amp with an RZ1ZR C5MAX controller.",
  "homepage": "https://github.com/RIGeek/RZ1ZR-C5MAX-Zeus-Feature",
  "license": "GPL-2.0-or-later",
  "sdk": { "abi": 1, "minVersion": "1.5.0" },
  "entrypoint": {
    "assembly": "Zeus.Community.HfAmp.dll",
    "type": "Zeus.Community.HfAmp.HfAmpPlugin"
  },
  "capabilities": ["NetworkAccess", "ReadRadioState", "PersistSettings"],
  "permissions": {
    "network": true,
    "fileSystemRead": false,
    "fileSystemWrite": false
  },
  "ui": {
    "modules": ["ui/hf-amp.js"],
    "panels": [
      {
        "id": "hf-amp",
        "title": "HF Amplifier",
        "slot": "workspace.hf-amp",
        "category": "amplifiers"
      }
    ]
  }
}
